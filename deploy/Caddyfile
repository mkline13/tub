# Example Caddyfile block for Tub. Caddy obtains and renews the certificate.
# "tub" is the container name on the shared Docker network.
tub.example.com {
	reverse_proxy tub:8787 {
		# Send server-sent events (/replication/<scope>/pull/stream) to clients
		# immediately instead of buffering them.
		flush_interval -1
	}
}

# Or, under a path on a shared domain. Clients then use
# https://proxy.example.com/tub as their URL.
#
# proxy.example.com {
# 	handle_path /tub/* {
# 		reverse_proxy tub:8787 {
# 			flush_interval -1
# 		}
# 	}
# }
